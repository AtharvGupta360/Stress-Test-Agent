# --- Database ---
DATABASE_URL=postgresql://stress:stress@localhost:5432/stressagent

# --- Model API ---
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Budgets (per submission) ---
MAX_TOKENS_PER_SUBMISSION=120000
MAX_LLM_CALLS_PER_SUBMISSION=12
MAX_WALL_SECONDS_PER_SUBMISSION=300

# --- Sandbox ---
SANDBOX_IMAGE=stressagent/sandbox:latest
SANDBOX_CPUS=1.0
SANDBOX_MEMORY=512m
SANDBOX_PIDS=128
SANDBOX_PER_RUN_TIMEOUT=5

# --- Stress loop ---
STRESS_ROUNDS=400
STRESS_TIME_BUDGET=60

# --- Worker ---
WORKER_CONCURRENCY=2
GLOBAL_SANDBOX_SLOTS=4

# --- Circuit breaker ---
BREAKER_FAIL_THRESHOLD=5
BREAKER_RESET_SECONDS=60
